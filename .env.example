# Active le backend Supabase (URL publique, pas un secret)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Variables serveur uniquement : ne jamais les préfixer par VITE_
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=remplacez-par-la-cle-service-role

# Code d'accès de l'espace admin (défaut : noizay)
# Mode Supabase : le serveur vérifie CAISSE_CODE.
CAISSE_CODE=1234
# Mode démo local (sans Supabase) : le navigateur vérifie VITE_CAISSE_CODE.
# VITE_CAISSE_CODE=1234

# E-mail de confirmation des réservations (Resend, https://resend.com)
# Sans clé, les réservations fonctionnent mais aucun e-mail n'est envoyé.
RESEND_API_KEY=re_remplacez-par-votre-cle
# Expéditeur vérifié dans Resend (domaine à valider, ou onboarding@resend.dev en test)
RESERVATION_EMAIL_FROM="Soirée Pizza Noizay <reservations@votre-domaine.fr>"
# Facultatif : adresse de réponse affichée dans l'e-mail
# RESERVATION_EMAIL_REPLY_TO=contact@votre-domaine.fr

